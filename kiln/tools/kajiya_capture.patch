--- /dev/null
+++ b/assets/shaders/capture/gbuffer_signal.hlsl
@@ -0,0 +1,13 @@
+#include "../inc/gbuffer.hlsl"
+[[vk::binding(0)]] Texture2D<float4> gbuffer_tex;
+[[vk::binding(1)]] Texture2D<float> shadow_tex;
+[[vk::binding(2)]] RWTexture2D<float4> output_tex;
+[[vk::binding(3)]] cbuffer Constants { uint signal; };
+[numthreads(8,8,1)]
+void main(uint2 px : SV_DispatchThreadID) {
+    GbufferData g = GbufferDataPacked::from_uint4(asuint(gbuffer_tex[px])).unpack();
+    if (signal == 3) output_tex[px] = float4(g.albedo, 1);
+    else if (signal == 4) output_tex[px] = float4(g.normal, 1);
+    else if (signal == 5) output_tex[px] = float4(g.roughness, g.metalness, 0, 1);
+    else output_tex[px] = float4(shadow_tex[px].xxx, 1);
+}
--- /dev/null
+++ b/assets/shaders/capture/intermediate_signal.hlsl
@@ -0,0 +1,7 @@
+[[vk::binding(0)]] Texture2D<float4> input_tex;
+[[vk::binding(1)]] RWTexture2D<float4> output_tex;
+[[vk::binding(2)]] cbuffer Constants { uint divisor; };
+[numthreads(8,8,1)]
+void main(uint2 px : SV_DispatchThreadID) {
+    output_tex[px] = input_tex[px / divisor];
+}
