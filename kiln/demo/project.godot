config_version=5

[application]
config/name="Kiln • Dynamic Island"
run/main_scene="res://island.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720

[rendering]
renderer/rendering_method="kiln_deferred"
renderer/rendering_method.mobile="kiln_deferred"
rendering_device/driver="metal"
anti_aliasing/quality/use_taa=true
lights_and_shadows/positional_shadow/atlas_size=4096
lights_and_shadows/directional_shadow/size=4096
limits/cluster_builder/max_clustered_elements=2048
textures/default_filters/use_nearest_mipmap_filter=false
