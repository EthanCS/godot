    if(any(lessThan(cell,ivec3(0)))||any(greaterThanEqual(cell,dims)))return vec3(0);
    int cell_id=(cell.z*dims.y+cell.y)*dims.x+cell.x;
    uint count=light_grid[cell_id*2+1],start=light_grid[cell_id*2];
