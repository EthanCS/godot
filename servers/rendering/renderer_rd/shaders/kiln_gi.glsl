        lo-=vec3(.001);hi+=vec3(.001);
    }else{
        Node a=nodes[id+1u];
        uint right=a.hi.w<0.0?id+2u:uint(a.hi.w);
        Node b=nodes[right];
        lo=min(a.lo.xyz,b.lo.xyz);hi=max(a.hi.xyz,b.hi.xyz);
    }
    nodes[id].lo=vec4(lo,n.lo.w);nodes[id].hi=vec4(hi,n.hi.w);
}

