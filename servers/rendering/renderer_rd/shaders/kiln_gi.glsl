        if (screen_gi.w > 0.0 && restir_relative_depth(clip.z, screen_depth) < 5e-3) gi = screen_gi.rgb;
    }
    return direct + tri.emission.rgb + gi * albedo;
}

vec3 restir_trace(vec3 origin, vec3 direction, vec3 query_normal, out vec4 hit, out float inv_pdf) {
    int id; float distance; vec3 normal;
    KilnFarField far_field = kiln_wrc_query(origin, direction, query_normal);
    inv_pdf = 1.0;
    if (world_trace(origin, direction, far_field.probe_t >= 0.0 ? far_field.probe_t : RESTIR_SKY_DISTANCE, false, id, distance, normal)) {
        normal = kiln_ray_normal(id);
        hit = vec4(normal, distance);
        return restir_hit_radiance(origin + direction * distance, normal, id, direction);
    }
    if (far_field.probe_t >= 0.0) { inv_pdf = far_field.inv_pdf; hit = vec4(-direction, far_field.surface_t); return far_field.radiance; }
    hit = vec4(-direction, RESTIR_SKY_DISTANCE);
    return kiln_sample_sky(restir_sky, direction);
}
