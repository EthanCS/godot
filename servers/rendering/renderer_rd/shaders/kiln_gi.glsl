        vec3 n=normalize(mat3(p.inv_view)*(p.engine_state.x>.5?texelFetch(normal,q,0).rgb:texelFetch(normal,q,0).rgb*2.0-1.0));
        vec4 clip=p.previous_view_projection*vec4(wp,1);
        vec2 old_pixel=(clip.xy/clip.w*.5+.5)*vec2(size)-.5;
        ivec2 base=ivec2(floor(old_pixel));
        float sum=0,weight=0;
        float pixel_world=2.0*abs(vp.z)/(abs(p.projection[1][1])*float(size.y));
        if(clip.w>0.0)for(int y=0;y<2;y++)for(int x=0;x<2;x++){
