    uint lane=gl_GlobalInvocationID.x;
    if(gl_GlobalInvocationID.y!=0u || lane>=uint(p.count))return;
    uint id=order[uint(p.offset)+lane];
    Node n=nodes[id];
    vec3 lo=vec3(3.402823e38),hi=-lo;
    if(n.hi.w<0.0){
        int end=int(n.lo.w)-int(n.hi.w)-1;
        for(int i=int(n.lo.w);i<end;i++){
            Triangle t=triangles[i];
            vec3 a=t.p0.xyz,b=a+t.e1.xyz,c=a+t.e2.xyz;
            lo=min(lo,min(a,min(b,c)));hi=max(hi,max(a,max(b,c)));
