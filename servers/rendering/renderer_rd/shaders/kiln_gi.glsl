layout(set = 0, binding = 28, std430) writeonly buffer RayResults {
	vec4 ray_results[];
};
layout(set = 0, binding = 37, std430) buffer RayGuiding {
	vec2 ray_guiding[]; // 4x4 cosine-domain bins per surfel: radiance mean, samples
