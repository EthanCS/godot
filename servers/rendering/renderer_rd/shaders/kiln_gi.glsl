    // avoid texture/float-hash seams and remain stable under camera motion.
    float cloud = 0.0;
    for (int i = 0; i < 12; i++) {
        float seed = fract(float(i) * 0.618033989 + 0.31);
        float angle = float(i) * 2.39996323;
