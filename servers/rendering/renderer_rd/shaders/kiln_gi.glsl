        uint rx=uint((x&s)>0u),ry=uint((y&s)>0u);
        index+=s*s*((3u*rx)^ry);
        if(ry==0u){if(rx==1u){x=63u-x;y=63u-y;}uint tmp=x;x=y;y=tmp;}
    }
    return index;
}

