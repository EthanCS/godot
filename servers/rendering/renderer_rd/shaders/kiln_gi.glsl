// lighting allocate_surfels.hlsl: pop the pool for the per-tile winning candidate.
// The new surfel sits at the clipmap cell center, seeded with the tile's
// weight-blended irradiance.
// Shared std140 contract. Matrices are Godot's already-corrected GPU projections.
layout(set=0,binding=0,std140) uniform Parameters {
    mat4 projection;
    mat4 inv_projection;
    mat4 inv_view;
    mat4 view;
    vec4 size_frame;       // full width, height, frame, history valid
    vec4 sun_direction;    // direction TO sun, energy
    vec4 sun_color;        // linear RGB, sky energy
    vec4 source_bvh_state; // static nodes, static triangles, GI enabled, continuous lighting response [0,1]
    vec4 dynamic_scene;    // dynamic nodes, dynamic triangles, emissive triangles, total sampling power
    vec4 kiln_prev_eye; // xyz: previous eye position, w: sun size multiplier
    vec4 lighting; // x: sun angular radius cos, y: ev shift, z: ReSTIR path enabled, w: previous frame index
    vec4 post; // sampling offset in pixels, frame delta seconds, reserved
    mat4 unjittered_projection;
    mat4 inverse_unjittered_projection;
    mat4 previous_unjittered_view_projection;
    mat4 previous_inverse_projection;
    mat4 previous_inverse_view;
} p;

const float PI=3.14159265358979323846;
vec3 safe_normalize(vec3 v) { return v * inversesqrt(max(dot(v,v),1e-16)); }
vec3 view_position(vec2 uv,float depth) {
    vec4 point=p.inv_projection*vec4(uv*2.0-1.0,depth,1.0);
    return point.xyz/point.w;
}
vec3 world_position(vec2 uv,float depth) {return (p.inv_view*vec4(view_position(uv,depth),1.0)).xyz;}
float luminance(vec3 v) {return dot(v,vec3(.2126,.7152,.0722));}

// lighting restir-meets-surfel shared math, ported for the parity comparison.
// Sources: lighting assets/shaders/inc/{hash,quasi_random,reservoir,working_color_space,
// pack_unpack}.hlsl and atmosphere_felix.hlsl (Felix Westin, MIT). The RNG streams are
// reproduced bit-for-bit so per-frame noise patterns line up between the engines.

const float KILN_M_PLASTIC = 1.32471795724474602596;
const float KILN_M_CBRT_2 = 1.2599210498948731647672106072782283505;
const float KILN_INFINITY = 1.0 / 0.0;

// ---- hash.hlsl ----
uint kiln_hash1(uint x) {
	x += (x << 10u);
	x ^= (x >> 6u);
	x += (x << 3u);
	x ^= (x >> 11u);
	x += (x << 15u);
	return x;
}

uint kiln_hash1_mut(inout uint h) {
	uint res = h;
	h = kiln_hash1(h);
	return res;
}

uint kiln_hash_combine2(uint x, uint y) {
	const uint M = 1664525u, C = 1013904223u;
	uint seed = (x * M + y + C) * M;
	// Tempering (from Matsumoto)
	seed ^= (seed >> 11u);
	seed ^= (seed << 7u) & 0x9d2c5680u;
	seed ^= (seed << 15u) & 0xefc60000u;
	seed ^= (seed >> 18u);
	return seed;
}

uint kiln_hash2(uvec2 v) {
	return kiln_hash_combine2(v.x, kiln_hash1(v.y));
}

uint kiln_hash3(uvec3 v) {
	return kiln_hash_combine2(v.x, kiln_hash2(v.yz));
}

uint kiln_hash4(uvec4 v) {
	return kiln_hash_combine2(v.x, kiln_hash3(v.yzw));
}

float kiln_uint_to_u01_float(uint h) {
	const uint mantissa_mask = 0x007FFFFFu;
	const uint one = 0x3F800000u;
	h &= mantissa_mask;
	h |= one;
	return uintBitsToFloat(h) - 1.0;
}

float kiln_interleaved_gradient_noise(uvec2 px) {
	return fract(52.9829189 * fract(0.06711056 * float(px.x) + 0.00583715 * float(px.y)));
}

// ---- quasi_random.hlsl ----
float kiln_radical_inverse_vdc(uint bits) {
	bits = (bits << 16u) | (bits >> 16u);
	bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
	bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
	bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
	bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
	return float(bits) * 2.3283064365386963e-10; // / 0x100000000
}

vec2 kiln_hammersley(uint i, uint n) {
	return vec2(float(i + 1) / n, kiln_radical_inverse_vdc(i + 1));
}

vec2 kiln_r2_sequence(uint i) {
	const float a1 = 1.0 / KILN_M_PLASTIC;
	const float a2 = 1.0 / (KILN_M_PLASTIC * KILN_M_PLASTIC);
	return fract(vec2(a1, a2) * i + 0.5);
}

// ---- reservoir.hlsl ----
struct KilnReservoir1spp {
	float w_sum;
	uint payload;
	float M;
	float W;
};

KilnReservoir1spp kiln_reservoir_create() {
	KilnReservoir1spp res;
	res.w_sum = 0.0;
	res.payload = 0u;
	res.M = 0.0;
	res.W = 0.0;
	return res;
}

KilnReservoir1spp kiln_reservoir_from_raw(vec4 raw) {
	KilnReservoir1spp res;
	res.w_sum = raw.x;
	res.payload = floatBitsToUint(raw.y);
	res.M = raw.z;
	res.W = raw.w;
	return res;
}

vec4 kiln_reservoir_as_raw(KilnReservoir1spp res) {
	return vec4(res.w_sum, uintBitsToFloat(res.payload), res.M, res.W);
}

bool kiln_reservoir_update(inout KilnReservoir1spp res, float w, uint sample_payload, inout uint rng) {
	res.w_sum += w;
	res.M += 1.0;
	const float dart = kiln_uint_to_u01_float(kiln_hash1_mut(rng));
	const float prob = w / res.w_sum;
	if (prob >= dart) {
		res.payload = sample_payload;
		return true;
	}
	return false;
}

// ---- working_color_space.hlsl (crunched luma-chroma used by temporal_filter2) ----
vec3 kiln_rgb_to_ycbcr(vec3 col) {
	return transpose(mat3(0.2126, 0.7152, 0.0722, -0.1146, -0.3854, 0.5, 0.5, -0.4542, -0.0458)) * col;
}

vec3 kiln_ycbcr_to_rgb(vec3 col) {
	return max(vec3(0.0), transpose(mat3(1.0, 0.0, 1.5748, 1.0, -0.1873, -0.4681, 1.0, 1.8556, 0.0)) * col);
}

vec4 kiln_linear_rgb_to_crunched_luma_chroma(vec4 v) {
	v.rgb = kiln_rgb_to_ycbcr(v.rgb);
	float k = sqrt(v.x) / max(1e-8, v.x);
	return vec4(v.rgb * k, v.a);
}

vec4 kiln_crunched_luma_chroma_to_linear_rgb(vec4 v) {
	v.rgb *= v.x;
	v.rgb = kiln_ycbcr_to_rgb(v.rgb);
	return v;
}

// ---- pack_unpack.hlsl ----
float kiln_unpack_unorm(uint pckd, uint bit_count) {
	uint max_val = (1u << bit_count) - 1u;
	return float(pckd & max_val) / float(max_val);
}

uint kiln_pack_unorm(float val, uint bit_count) {
	uint max_val = (1u << bit_count) - 1u;
	return uint(clamp(val, 0.0, 1.0) * float(max_val));
}

float kiln_pack_normal_11_10_11(vec3 n) {
	uint pckd = 0u;
	pckd += kiln_pack_unorm(n.x * 0.5 + 0.5, 11u);
	pckd += kiln_pack_unorm(n.y * 0.5 + 0.5, 10u) << 11u;
	pckd += kiln_pack_unorm(n.z * 0.5 + 0.5, 11u) << 21u;
	return uintBitsToFloat(pckd);
}

vec3 kiln_unpack_normal_11_10_11(uint p) {
	return normalize(vec3(
		kiln_unpack_unorm(p, 11u),
		kiln_unpack_unorm(p >> 11u, 10u),
		kiln_unpack_unorm(p >> 21u, 11u)) * 2.0 - 1.0);
}

vec3 kiln_unpack_normal_11_10_11_no_normalize(uint p) {
	return vec3(
		kiln_unpack_unorm(p, 11u),
		kiln_unpack_unorm(p >> 11u, 10u),
		kiln_unpack_unorm(p >> 21u, 11u)) * 2.0 - 1.0;
}

// ---- atmosphere_felix.hlsl (Felix Westin, MIT; lighting USE_FELIX_ATMOSPHERE path) ----
const float KILN_PLANET_RADIUS = 6371000.0;
const vec3 KILN_PLANET_CENTER = vec3(0.0, -KILN_PLANET_RADIUS, 0.0);
const float KILN_ATMOSPHERE_HEIGHT = 100000.0;
const float KILN_RAYLEIGH_HEIGHT = KILN_ATMOSPHERE_HEIGHT * 0.08;
const float KILN_MIE_HEIGHT = KILN_ATMOSPHERE_HEIGHT * 0.012;
const vec3 KILN_C_RAYLEIGH = vec3(5.802, 13.558, 33.100) * 1e-6;
const vec3 KILN_C_MIE = vec3(3.996, 3.996, 3.996) * 1e-6;
const vec3 KILN_C_OZONE = vec3(0.650, 1.881, 0.085) * 1e-6;
const float KILN_ATMOSPHERE_DENSITY = 1.0;
const float KILN_ATMOSPHERE_EXPOSURE = 20.0;

vec2 kiln_sphere_intersection(vec3 ray_start, vec3 ray_dir, vec3 sphere_center, float sphere_radius) {
	ray_start -= sphere_center;
	float a = dot(ray_dir, ray_dir);
	float b = 2.0 * dot(ray_start, ray_dir);
	float c = dot(ray_start, ray_start) - (sphere_radius * sphere_radius);
	float d = b * b - 4.0 * a * c;
	if (d < 0.0) {
		return vec2(-1.0);
	}
	d = sqrt(d);
	return vec2(-b - d, -b + d) / (2.0 * a);
}

vec2 kiln_planet_intersection(vec3 ray_start, vec3 ray_dir) {
	return kiln_sphere_intersection(ray_start, ray_dir, KILN_PLANET_CENTER, KILN_PLANET_RADIUS);
}

vec2 kiln_atmosphere_intersection(vec3 ray_start, vec3 ray_dir) {
	return kiln_sphere_intersection(ray_start, ray_dir, KILN_PLANET_CENTER, KILN_PLANET_RADIUS + KILN_ATMOSPHERE_HEIGHT);
}

float kiln_phase_rayleigh(float costh) {
	return 3.0 * (1.0 + costh * costh) / (16.0 * PI);
}

float kiln_phase_mie(float costh, float g) {
	g = min(g, 0.9381);
	float k = 1.55 * g - 0.55 * g * g * g;
	float kcosth = k * costh;
	return (1.0 - k * k) / ((4.0 * PI) * (1.0 - kcosth) * (1.0 - kcosth));
}

float kiln_atmosphere_height(vec3 position_ws) {
	return distance(position_ws, KILN_PLANET_CENTER) - KILN_PLANET_RADIUS;
}

float kiln_density_rayleigh(float h) {
	return exp(-max(0.0, h / KILN_RAYLEIGH_HEIGHT));
}

float kiln_density_mie(float h) {
	return exp(-max(0.0, h / KILN_MIE_HEIGHT));
}

float kiln_density_ozone(float h) {
	// Tent function, 30 km wide, centered at 25 km altitude.
	return max(0.0, 1.0 - abs(h - 25000.0) / 15000.0);
}

vec3 kiln_atmosphere_density(float h) {
	return vec3(kiln_density_rayleigh(h), kiln_density_mie(h), kiln_density_ozone(h));
}

vec3 kiln_integrate_optical_depth(vec3 ray_start, vec3 ray_dir) {
	vec2 intersection = kiln_atmosphere_intersection(ray_start, ray_dir);
	float ray_length = intersection.y;

	const int sample_count = 8;
	float step_size = ray_length / float(sample_count);

	vec3 optical_depth = vec3(0.0);
	for (int i = 0; i < sample_count; i++) {
		vec3 local_position = ray_start + ray_dir * (float(i) + 0.5) * step_size;
		float local_height = kiln_atmosphere_height(local_position);
		vec3 local_density = kiln_atmosphere_density(local_height);
		optical_depth += local_density * step_size;
	}
	return optical_depth;
}

vec3 kiln_absorb(vec3 optical_depth) {
	// Mie results in slightly more absorption than scattering, about 10%.
	return exp(-(optical_depth.x * KILN_C_RAYLEIGH + optical_depth.y * KILN_C_MIE * 1.1 + optical_depth.z * KILN_C_OZONE) * KILN_ATMOSPHERE_DENSITY);
}

vec3 kiln_integrate_scattering(vec3 ray_start, vec3 ray_dir, float ray_length, vec3 light_dir, vec3 light_color, out vec3 transmittance) {
	float sample_distribution_exponent = 5.0;

	vec2 intersection = kiln_atmosphere_intersection(ray_start, ray_dir);
	ray_length = min(ray_length, intersection.y);
	if (intersection.x > 0.0) {
		// Advance ray to the atmosphere entry point.
		ray_start += ray_dir * intersection.x;
		ray_length -= intersection.x;
	}

	float costh = dot(ray_dir, light_dir);
	float phase_r = kiln_phase_rayleigh(costh);
	float phase_m = kiln_phase_mie(costh, 0.85);

	const int sample_count = 16;

	vec3 optical_depth = vec3(0.0);
	vec3 rayleigh = vec3(0.0);
	vec3 mie = vec3(0.0);

	float prev_ray_time = 0.0;

	for (int i = 1; i <= sample_count; i++) {
		float ray_time = pow(float(i) / float(sample_count), sample_distribution_exponent) * ray_length;
		float step_size = (ray_time - prev_ray_time);

		vec3 local_position = ray_start + ray_dir * mix(prev_ray_time, ray_time, 0.5);
		float local_height = kiln_atmosphere_height(local_position);
		vec3 local_density = kiln_atmosphere_density(local_height);

		optical_depth += local_density * step_size;

		// The atmospheric transmittance from ray_start to local_position.
		vec3 view_transmittance = kiln_absorb(optical_depth);

		vec3 optical_depth_light = kiln_integrate_optical_depth(local_position, light_dir);
		// The atmospheric transmittance of light reaching local_position.
		vec3 light_transmittance = kiln_absorb(optical_depth_light);

		rayleigh += view_transmittance * light_transmittance * phase_r * local_density.x * step_size;
		mie += view_transmittance * light_transmittance * phase_m * local_density.y * step_size;

		prev_ray_time = ray_time;
	}

	transmittance = kiln_absorb(optical_depth);

	return (rayleigh * KILN_C_RAYLEIGH + mie * KILN_C_MIE) * light_color * KILN_ATMOSPHERE_EXPOSURE;
}

// ---- sun.hlsl / atmosphere.hlsl (lighting's sun and sky for the GI path) ----
// lighting evaluates the atmosphere from the world origin for both the sun color and
// the sky cube; scene content is assumed to sit within a few km of the origin.
vec3 kiln_sun_color(vec3 sun_direction, vec3 sun_color_multiplier) {
	return 20.0 * sun_color_multiplier * kiln_absorb(kiln_integrate_optical_depth(vec3(0.0), sun_direction));
}

vec3 kiln_atmosphere_default(vec3 wi, vec3 light_dir, vec3 sky_ambient, vec3 sun_color_multiplier) {
	vec3 ray_start = vec3(0.0);
	vec3 ray_dir = wi;
	float ray_length = KILN_INFINITY;

	vec3 transmittance;
	return sky_ambient + sun_color_multiplier *
			kiln_integrate_scattering(ray_start, ray_dir, ray_length, light_dir, vec3(1.0), transmittance);
}

// Kajiya inc/math.hlsl, Frisvad orthonormal frame (GLSL column vectors).
mat3 kiln_orthonormal_basis(vec3 n) {
    if (n.z < 0.0) {
        float a = 1.0 / (1.0 - n.z), b = n.x * n.y * a;
        return mat3(vec3(1.0 - n.x*n.x*a, -b, n.x), vec3(b, n.y*n.y*a - 1.0, -n.y), n);
    }
    float a = 1.0 / (1.0 + n.z), b = -n.x*n.y*a;
    return mat3(vec3(1.0 - n.x*n.x*a, b, -n.x), vec3(b, 1.0 - n.y*n.y*a, -n.y), n);
}

// lighting restir-meets-surfel surfel pool, clipmap grid and lookup, ported for the
// parity comparison. Sources: lighting assets/shaders/surfel_gi/{surfel_constants,
// surfel_grid_hash,surfel_binning_shared,lookup}.hlsl. The half-migrated hash table
// of the reference is reduced to its effective modulo behavior.
//
// Buffer binding contract shared by every KILN_* stage (set 0), kept clear of
// the bvh.inc and kiln surfel bindings:
//  40 surfel_meta_buf       8 x u32    [1] live count, [2] alloc pointer
//  41 surfel_pool_buf       u32 x MAX  LIFO free-index stack
//  42 cell_index_offset_buf u32 x MAX+1 per-cell inclusive prefix sum
//  43 surfel_index_buf      u32 x MAX*24 sorted surfel ids per cell
//  44 surfel_spatial_buf    vec4 x MAX xyz = position, w bits = packed normal 11:10:11
//  45 surfel_irradiance_buf vec4 x MAX rgb = irradiance, a = accumulated samples
//  46 surfel_aux_buf        vec4 x MAX*2 [2i] blended radiance + count, [2i] MSME state
//  47 surfel_life_buf       u32 x MAX  age; valid < 100
//  48 surfel_reposition_proposal_buf vec4 x MAX next trace origin proposal

#define KILN_MAX_SURFEL_CELLS 262144u
#define KILN_MAX_SURFELS 262144u
#define KILN_MAX_SURFELS_PER_CELL 128u
#define KILN_MAX_SURFELS_PER_CELL_FOR_KEEP_ALIVE 32u
#define KILN_SURFELS_PER_CELL_SLOTS 24u
#define KILN_SURFEL_CS 32u

const float KILN_SURFEL_GRID_CELL_DIAMETER = 0.2;
const float KILN_SURFEL_BASE_RADIUS = 0.24;
const float KILN_SURFEL_RADIUS_OVERSCALE = 1.25; // [sic] reference typo preserved
const float KILN_SURFEL_NORMAL_DIRECTION_SQUISH = 2.0;

const uint KILN_SURFEL_META_SURFEL_COUNT = 4u;
const uint KILN_SURFEL_META_ALLOC_COUNT = 8u;
const uint KILN_SURFEL_LIFE_RECYCLE = 0x8000000u;
const uint KILN_SURFEL_LIFE_RECYCLED = KILN_SURFEL_LIFE_RECYCLE + 1u;

bool kiln_is_surfel_life_valid(uint life) {
	return life < 100u;
}

bool kiln_surfel_life_needs_aging(uint life) {
	return life != KILN_SURFEL_LIFE_RECYCLED;
}

// Access qualifiers reflect each stage's use into RD dependencies, following the
// kiln sources convention. The meta buffer is read-write everywhere: the count
// is read by most stages while allocation and aging issue atomics on it.
#define KILN_META_ACCESS
#ifdef STAGE_KILN_SURFEL_CLEAR_POOL
#define KILN_POOL_ACCESS writeonly
#elif defined(STAGE_KILN_SURFEL_ALLOCATE) || defined(STAGE_KILN_SURFEL_AGE)
#define KILN_POOL_ACCESS
#else
#define KILN_POOL_ACCESS readonly
#endif
#if defined(STAGE_KILN_SURFEL_CLEAR_CELLS) || defined(STAGE_KILN_SURFEL_COUNT_CELLS) || defined(STAGE_KILN_SURFEL_SLOT_CELLS)
#define KILN_CELL_ACCESS
#else
#define KILN_CELL_ACCESS readonly
#endif
#ifdef STAGE_KILN_SURFEL_SLOT_CELLS
#define KILN_INDEX_ACCESS
#else
#define KILN_INDEX_ACCESS readonly
#endif
#if defined(STAGE_KILN_SURFEL_ALLOCATE)
#define KILN_SPATIAL_ACCESS
#else
#define KILN_SPATIAL_ACCESS readonly
#endif
#if defined(STAGE_KILN_SURFEL_ALLOCATE) || defined(STAGE_KILN_SURFEL_TRACE)
#define KILN_IRRADIANCE_ACCESS
#else
#define KILN_IRRADIANCE_ACCESS readonly
#endif
#if defined(STAGE_KILN_SURFEL_TRACE) || defined(STAGE_KILN_SURFEL_ALLOCATE)
#define KILN_AUX_ACCESS
#else
#define KILN_AUX_ACCESS readonly
#endif
#define KILN_LIFE_ACCESS
#if defined(STAGE_KILN_SURFEL_FIND_MISSING) || defined(STAGE_KILN_SURFEL_ALLOCATE)
#define KILN_PROPOSAL_ACCESS
#else
#define KILN_PROPOSAL_ACCESS readonly
#endif

layout(set = 0, binding = 40, std430) KILN_META_ACCESS buffer KilnMetaBuf { uint kiln_surfel_meta_buf[]; };
layout(set = 0, binding = 41, std430) KILN_POOL_ACCESS buffer KilnPoolBuf { uint kiln_surfel_pool_buf[]; };
layout(set = 0, binding = 42, std430) KILN_CELL_ACCESS buffer KilnCellOffsetBuf { uint kiln_cell_index_offset_buf[]; };
layout(set = 0, binding = 43, std430) KILN_INDEX_ACCESS buffer KilnIndexBuf { uint kiln_surfel_index_buf[]; };
layout(set = 0, binding = 44, std430) KILN_SPATIAL_ACCESS buffer KilnSpatialBuf { vec4 kiln_surfel_spatial_buf[]; };
layout(set = 0, binding = 45, std430) KILN_IRRADIANCE_ACCESS buffer KilnIrradianceBuf { vec4 kiln_surfel_irradiance_buf[]; };
layout(set = 0, binding = 46, std430) KILN_AUX_ACCESS buffer KilnAuxBuf { vec4 kiln_surfel_aux_buf[]; };
layout(set = 0, binding = 47, std430) KILN_LIFE_ACCESS buffer KilnLifeBuf { uint kiln_surfel_life_buf[]; };
layout(set = 0, binding = 48, std430) KILN_PROPOSAL_ACCESS buffer KilnProposalBuf { vec4 kiln_surfel_reposition_proposal_buf[]; };

vec3 kiln_surfel_position(uint idx) {
	return kiln_surfel_spatial_buf[idx].xyz;
}

vec3 kiln_surfel_normal(uint idx) {
	return kiln_unpack_normal_11_10_11_no_normalize(floatBitsToUint(kiln_surfel_spatial_buf[idx].w));
}

// ---- surfel_grid_hash.hlsl ----
vec3 kiln_get_eye_position() {
	return p.inv_view[3].xyz;
}

vec3 kiln_get_prev_eye_position() {
	return p.kiln_prev_eye.xyz;
}

ivec3 kiln_surfel_pos_to_grid_coord(vec3 pos, vec3 eye_pos) {
	return ivec3(floor((pos - eye_pos) / KILN_SURFEL_GRID_CELL_DIAMETER));
}

vec3 kiln_surfel_grid_coord_center(uvec4 coord, vec3 eye_pos) {
	return eye_pos + ((vec3(coord.xyz) + 0.5 - float(KILN_SURFEL_CS) * 0.5) * KILN_SURFEL_GRID_CELL_DIAMETER) * float(1u << coord.w);
}

float kiln_surfel_grid_coord_to_cascade_float(ivec3 coord) {
	const vec3 fcoord = vec3(coord) + 0.5;
	const float max_coord = max(abs(fcoord.x), max(abs(fcoord.y), abs(fcoord.z)));
	return log2(max_coord / (float(KILN_SURFEL_CS) * 0.5));
}

uint kiln_cascade_float_to_cascade(float cascade_float) {
	return uint(clamp(ceil(max(0.0, cascade_float)), 0.0, 7.0));
}

uint kiln_surfel_grid_coord_to_cascade(ivec3 coord) {
	return kiln_cascade_float_to_cascade(kiln_surfel_grid_coord_to_cascade_float(coord));
}

float kiln_surfel_radius_for_pos(vec3 pos) {
	return KILN_SURFEL_BASE_RADIUS * max(1.0, length(pos - kiln_get_eye_position()) / (KILN_SURFEL_GRID_CELL_DIAMETER * float(KILN_SURFEL_CS) * 0.5));
}

ivec3 kiln_surfel_grid_coord_within_cascade(ivec3 coord, uint cascade) {
	return (coord >> int(cascade)) + int(KILN_SURFEL_CS / 2);
}

uvec4 kiln_surfel_grid_coord_to_c4(ivec3 coord) {
	const uint cascade = kiln_surfel_grid_coord_to_cascade(coord);
	const uvec3 ucoord_in_cascade = uvec3(clamp(kiln_surfel_grid_coord_within_cascade(coord, cascade), ivec3(0), ivec3(KILN_SURFEL_CS - 1u)));
	return uvec4(ucoord_in_cascade, cascade);
}

uint kiln_surfel_grid_c4_to_hash(uvec4 c4) {
	// GLSL has no integer dot(); the reference relies on HLSL's uint4 dot.
	return c4.x + c4.y * KILN_SURFEL_CS + c4.z * (KILN_SURFEL_CS * KILN_SURFEL_CS) + c4.w * (KILN_SURFEL_CS * KILN_SURFEL_CS * KILN_SURFEL_CS);
}

uint kiln_surfel_grid_coord_to_hash(ivec3 coord) {
	return kiln_surfel_grid_c4_to_hash(kiln_surfel_grid_coord_to_c4(coord)) % KILN_MAX_SURFEL_CELLS;
}

uint kiln_cell_range_begin(uint cell_idx) {
	return kiln_cell_index_offset_buf[cell_idx];
}

uint kiln_cell_range_end(uint cell_idx) {
	return kiln_cell_index_offset_buf[cell_idx + 1u];
}

// ---- surfel_binning_shared.hlsl ----
uint kiln_surfel_cascade_for_pos(vec3 position) {
	const float fc = kiln_surfel_grid_coord_to_cascade_float(kiln_surfel_pos_to_grid_coord(position, kiln_get_eye_position()));
	return kiln_cascade_float_to_cascade(fc);
}

bool kiln_surfel_intersects_grid_coord(vec3 position, vec3 normal, uvec4 grid_coord) {
	const float surfel_radius = kiln_surfel_radius_for_pos(position);

	const vec3 cell_center = kiln_surfel_grid_coord_center(grid_coord, kiln_get_eye_position());
	const float grid_cell_radius = (KILN_SURFEL_GRID_CELL_DIAMETER * 0.5) * float(1u << grid_coord.w);

	const vec3 cell_local_surfel_pos = position - cell_center;
	const vec3 cell_local_closest_point_on_grid_cell = clamp(cell_local_surfel_pos, vec3(-grid_cell_radius), vec3(grid_cell_radius));

	const vec3 pos_offset = cell_local_surfel_pos - cell_local_closest_point_on_grid_cell;

	// Approximate box-ellipsoid culling. Sometimes misses corners, but greatly
	// improves culling efficiency (reference preserves this behavior).
	const float mahalanobis_dist = length(pos_offset) * (1.0 + abs(dot(pos_offset, normal)) * KILN_SURFEL_NORMAL_DIRECTION_SQUISH);
	return mahalanobis_dist < surfel_radius;
}

struct KilnSurfelGridMinMax {
	uvec4 c4_min[2];
	uvec4 c4_max[2];
	uint cascade_count;
};

KilnSurfelGridMinMax kiln_get_surfel_grid_box_min_max(vec3 position) {
	const float surfel_radius = kiln_surfel_radius_for_pos(position);

	const vec3 box_min_pos = position - surfel_radius;
	const vec3 box_max_pos = position + surfel_radius;

	const vec3 eye_pos = kiln_get_eye_position();
	const float fc = kiln_surfel_grid_coord_to_cascade_float(kiln_surfel_pos_to_grid_coord(position, eye_pos));

	const uint c0 = kiln_cascade_float_to_cascade(fc - 0.2);
	const uint c1 = kiln_cascade_float_to_cascade(fc + 0.2);

	const ivec3 min_coord = kiln_surfel_pos_to_grid_coord(box_min_pos, eye_pos);
	const ivec3 max_coord = kiln_surfel_pos_to_grid_coord(box_max_pos, eye_pos);

	KilnSurfelGridMinMax result;

	result.cascade_count = 1u;
	result.c4_min[0] = uvec4(clamp(kiln_surfel_grid_coord_within_cascade(min_coord, c0), ivec3(0), ivec3(KILN_SURFEL_CS - 1u)), c0);
	result.c4_max[0] = uvec4(clamp(kiln_surfel_grid_coord_within_cascade(max_coord, c0), ivec3(0), ivec3(KILN_SURFEL_CS - 1u)), c0);

	if (c1 != c0) {
		result.cascade_count = 2u;
		result.c4_min[1] = uvec4(clamp(kiln_surfel_grid_coord_within_cascade(min_coord, c1), ivec3(0), ivec3(KILN_SURFEL_CS - 1u)), c1);
		result.c4_max[1] = uvec4(clamp(kiln_surfel_grid_coord_within_cascade(max_coord, c1), ivec3(0), ivec3(KILN_SURFEL_CS - 1u)), c1);
	}

	return result;
}

// The reference updates irradiance in place during the trace dispatch. Keep
// that transport schedule; independent runs can differ with GPU work ordering.
// ---- lookup.hlsl ----
vec3 kiln_lookup_surfel_gi(vec3 pt_ws, vec3 normal_ws) {
	const uint cell_idx = kiln_surfel_grid_coord_to_hash(kiln_surfel_pos_to_grid_coord(pt_ws, kiln_get_eye_position()));

	uint range_begin = kiln_cell_range_begin(cell_idx);
	uint range_end = kiln_cell_range_end(cell_idx);
	// TEMP HACK (reference): never iterate over tons of surfels out of bounds.
	range_end = min(range_end, range_begin + KILN_MAX_SURFELS_PER_CELL);

	vec3 total_color = vec3(0.0);
	float total_weight = 0.0;

	for (uint surfel_idx_loc = range_begin; surfel_idx_loc < range_end; ++surfel_idx_loc) {
		const uint surfel_idx = kiln_surfel_index_buf[surfel_idx_loc];

#ifndef KILN_SURFEL_LOOKUP_DONT_KEEP_ALIVE
		if (range_end - range_begin <= KILN_MAX_SURFELS_PER_CELL_FOR_KEEP_ALIVE) {
			kiln_surfel_life_buf[surfel_idx] = 0u;
		}
#endif

		const vec3 surfel_position = kiln_surfel_position(surfel_idx);
		const vec3 surfel_normal = kiln_surfel_normal(surfel_idx);
        const vec4 surfel_irradiance_packed = kiln_surfel_irradiance_buf[surfel_idx];

		const vec3 pos_offset = pt_ws - surfel_position;
		const float directional_weight = max(0.0, dot(surfel_normal, normal_ws));
		const float mahalanobis_dist = length(pos_offset) * (1.0 + abs(dot(pos_offset, surfel_normal)) * KILN_SURFEL_NORMAL_DIRECTION_SQUISH);

		const float surfel_radius = kiln_surfel_radius_for_pos(surfel_position);
		const float weight = (1.0 - smoothstep(0.0, surfel_radius * KILN_SURFEL_RADIUS_OVERSCALE, mahalanobis_dist)) * directional_weight;

		total_weight += weight;
		total_color += surfel_irradiance_packed.xyz * weight;
	}

	total_color /= max(0.1, total_weight);
	return total_color;
}

layout(set = 0, binding = 10) uniform sampler2D kdepth;
layout(set = 0, binding = 11) uniform usampler2D ksurface;
layout(set = 0, binding = 12, rg32ui) uniform readonly uimage2D tile_alloc_tex;
layout(set = 0, binding = 13, rgba32f) uniform readonly image2D tile_irradiance_tex;
layout(set = 0, binding = 14) uniform sampler2D shading_normal_tex;
layout(local_size_x = 8, local_size_y = 8) in;
void main() {
	uvec2 tile_px = gl_GlobalInvocationID.xy;
	ivec2 tiles = ivec2(ceil(p.size_frame.xy / 8.0));
	if (any(greaterThanEqual(ivec2(tile_px), tiles))) {
		return;
	}

	uvec2 tile_surfel_alloc_packed = imageLoad(tile_alloc_tex, ivec2(tile_px)).xy;
	if (tile_surfel_alloc_packed.x == 0u) {
		return;
	}

	const uint px_score_loc_packed = tile_surfel_alloc_packed.x;
	const uint cell_idx = tile_surfel_alloc_packed.y;

	const uvec2 px = tile_px * 8u + uvec2(px_score_loc_packed & 7u, (px_score_loc_packed >> 3u) & 7u);
	vec2 size = p.size_frame.xy;
	vec2 uv = (vec2(px) + 0.5) / size;

	float z_over_w = texelFetch(kdepth, ivec2(px), 0).r;
	if (z_over_w == 0.0) {
		return;
	}

	vec4 pt_vs = p.inv_projection * vec4(uv * 2.0 - 1.0, z_over_w, 1.0);
	pt_vs /= pt_vs.w;
	vec3 pt_ws = (p.inv_view * vec4(pt_vs.xyz, 1.0)).xyz;

	if (any(isnan(pt_ws)) || any(isinf(pt_ws))) {
		return;
	}

	const vec3 eye_pos = kiln_get_eye_position();
	const uvec4 c4_coord = kiln_surfel_grid_coord_to_c4(kiln_surfel_pos_to_grid_coord(pt_ws, eye_pos));
	const vec3 c4_center = kiln_surfel_grid_coord_center(c4_coord, eye_pos);

	// Allocate with the candidate's packed shading normal, as in the reference.
	// Later reposition proposals deliberately use geometric normals instead.
	vec3 normal_ws = safe_normalize(mat3(p.inv_view) * safe_normalize(texelFetch(shading_normal_tex, ivec2(px), 0).xyz));
	vec4 surfel_entry = vec4(c4_center, kiln_pack_normal_11_10_11(normal_ws));

	// Match the reference's atomic fetch-add allocation order. A CAS spin loop
	// changes the mapping from pixels to surfel IDs and thus their ray sequences.
	uint surfel_alloc_idx = atomicAdd(kiln_surfel_meta_buf[KILN_SURFEL_META_ALLOC_COUNT / 4u], 1u);
	if (surfel_alloc_idx >= KILN_MAX_SURFELS) {
		atomicAdd(kiln_surfel_meta_buf[KILN_SURFEL_META_ALLOC_COUNT / 4u], -1u);
		return;
	}

	const uint surfel_idx = kiln_surfel_pool_buf[surfel_alloc_idx];
	atomicMax(kiln_surfel_meta_buf[KILN_SURFEL_META_SURFEL_COUNT / 4u], surfel_idx + 1u);

	// Clear dead state, mark used.
	kiln_surfel_life_buf[surfel_idx] = 0u;

	kiln_surfel_spatial_buf[surfel_idx] = surfel_entry;
	kiln_surfel_reposition_proposal_buf[surfel_idx] = surfel_entry;

	// Irradiance at the interpolated surfel position.
	vec4 source_irradiance = imageLoad(tile_irradiance_tex, ivec2(tile_px));

	// Starting radiance and sample count for the new surfel.
	vec4 start_irradiance_and_sample_count = max(vec4(0.0), vec4(
			source_irradiance.rgb,
			min(64.0, 32.0 * source_irradiance.a)));

	kiln_surfel_aux_buf[surfel_idx * 2u + 0u] = start_irradiance_and_sample_count;
	kiln_surfel_aux_buf[surfel_idx * 2u + 1u] = vec4(0.0);
	kiln_surfel_irradiance_buf[surfel_idx] = start_irradiance_and_sample_count;
}

#endif

