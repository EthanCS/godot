ivec4 world_key(vec3 position,vec3 normal){
    vec3 an=abs(normal);
    int axis=an.x>an.y?(an.x>an.z?0:2):(an.y>an.z?1:2);
    return ivec4(ivec3(floor(position/0.08)),int(p.voxel_state.w)*8+axis*2+int(normal[axis]<0.0));
