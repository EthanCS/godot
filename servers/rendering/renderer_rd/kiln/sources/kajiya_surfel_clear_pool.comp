#version 450
// kajiya clear_surfel_pool.hlsl: one-time LIFO free-list initialization.
// @GI_COMMON@
// @KAJIYA_COMMON@
// @KAJIYA_SURFEL@
layout(local_size_x = 64) in;
void main() {
	uint idx = gl_GlobalInvocationID.x;
	if (idx >= KAJIYA_MAX_SURFELS) {
		return;
	}
	kajiya_surfel_pool_buf[idx] = idx;
}
