#version 450
// @GI_COMMON@
// 256 moving batches * at most 16 rays, plus the 8192 bounce offset fit in
// this 128x128 table. Stationary integration uses at most 1024 samples.
layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
layout(set=0,binding=1,rgba32f) uniform writeonly image2D output_sequence;
layout(set=0,binding=2,r16ui) uniform writeonly uimage2D output_hilbert;
float radical_inverse(uint index,uint base){
    float inverse=1.0/float(base),place=inverse,value=0.0;
    while(index>0u){value+=float(index%base)*place;index/=base;place*=inverse;}
    return value;
}
void main(){
    ivec2 q=ivec2(gl_GlobalInvocationID.xy);
    uint index=uint(q.y*128+q.x)+1u;
    imageStore(output_sequence,q,vec4(radical_inverse(index,2u),radical_inverse(index,3u),
        radical_inverse(index,5u),radical_inverse(index,7u)));
    if(all(lessThan(q,ivec2(64))))imageStore(output_hilbert,q,uvec4(hilbert_index(uvec2(q))));
}
