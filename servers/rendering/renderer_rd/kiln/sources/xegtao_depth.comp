// @GI_COMMON@
// XeGTAO depth conversion and weighted depth pyramid. See rendering/xegtao/README.md.
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=1) uniform sampler2D input_depth;
layout(set=0,binding=2,r32f) uniform writeonly image2D output_depth;
layout(push_constant,std430) uniform Pass { int mip; } pass;
void main(){
    ivec2 q=ivec2(gl_GlobalInvocationID.xy),size=imageSize(output_depth);
    if(any(greaterThanEqual(q,size)))return;
    float z;
    if(pass.mip==0){
        float d=texelFetch(input_depth,q,0).r;
        z=d>1e-7 ? -view_position((vec2(q)+.5)/vec2(size),d).z : 1e6;
    }else{
        ivec2 last=textureSize(input_depth,0)-1;
        vec4 depths=vec4(texelFetch(input_depth,min(q*2,last),0).r,
            texelFetch(input_depth,min(q*2+ivec2(1,0),last),0).r,
            texelFetch(input_depth,min(q*2+ivec2(0,1),last),0).r,
            texelFetch(input_depth,min(q*2+ivec2(1,1),last),0).r);
        float farthest=max(max(depths.x,depths.y),max(depths.z,depths.w));
        float radius=.75*p.gi.x*1.457;
        vec4 w=clamp(1.0+(radius*.385-(vec4(farthest)-depths))/(radius*.615),0.0,1.0);
        z=dot(w,depths)/max(dot(w,vec4(1)),1e-8);
    }
    imageStore(output_depth,q,vec4(z));
}
