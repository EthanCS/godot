#version 450
// Kajiya rt/trace_sun_shadow_mask.rgen.hlsl, MIT. Engine ray-query adapter.
#define KILN_TRACE_MIN_DISTANCE 0.0
// @GI_COMMON@
// @BVH@
// @KILN_COMMON@
// @KILN_RESTIR_COMMON@
layout(set=0,binding=6) uniform usampler2D geometric_normal_tex;
layout(set=0,binding=10,r8) uniform writeonly image2D shadow_out;
layout(local_size_x=8,local_size_y=8) in;
void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (!restir_inside(px, ivec2(p.size_frame.xy))) return;
    float depth = texelFetch(restir_depth, px, 0).r;
    if (depth == 0.0) { imageStore(shadow_out, px, vec4(1.0)); return; }
    vec3 position_vs = view_position(restir_uv(px), depth);
    vec3 position_ws = (p.inv_view * vec4(position_vs, 1.0)).xyz;
    vec2 f = unpackSnorm2x16(texelFetch(geometric_normal_tex, px, 0).y);
    vec3 n = vec3(f, 1.0-abs(f.x)-abs(f.y));
    if (n.z < 0.0) n.xy = (1.0-abs(n.yx)) * mix(vec2(-1.0), vec2(1.0), greaterThanEqual(n.xy, vec2(0.0)));
    n = round((normalize(n) * 0.5 + 0.5) * 1023.0) / 1023.0 * 2.0 - 1.0;
    vec3 normal_ws = mat3(p.inv_view) * n;
    vec3 origin = position_ws + normal_ws * (-position_vs.z + length(position_ws)) * 1e-5;
    vec2 u = restir_blue(px, uint(p.size_frame.z)).xy;
    float z = mix(1.0, p.lighting.x, u.x), r = sqrt(max(0.0, 1.0-z*z));
    vec3 direction = restir_basis(p.sun_direction.xyz) * vec3(r*cos(u.y*2.0*PI), r*sin(u.y*2.0*PI), z);
    imageStore(shadow_out, px, vec4(occluded(origin, direction) ? 0.0 : 1.0));
}
