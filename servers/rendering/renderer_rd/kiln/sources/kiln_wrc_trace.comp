#version 450
// Kajiya wrc/trace_wrc.rgen.hlsl, MIT. One ray per probe texel, 8-frame blend.
#define KILN_TRACE_MIN_DISTANCE 1.2599210498948732
#define KILN_VISIBILITY_MIN_DISTANCE 0.0001
#define KILN_TRACE_CULL_BACK_FACES
#define KILN_SURFEL_LOOKUP_DONT_KEEP_ALIVE
// @GI_COMMON@
// @BVH@
// @KILN_COMMON@
// @KILN_SKY@
// @KILN_BRDF@
// @KILN_RAY_MATERIAL@
// @KILN_SURFEL@
// @KILN_WRC@
layout(set=0,binding=19) uniform samplerCube wrc_sky;
layout(set=0,binding=20) uniform sampler2D wrc_fg;
layout(set=0,binding=21,rgba32f) uniform image2D wrc_output;
layout(local_size_x=64) in;
void main() {
    uint index=gl_GlobalInvocationID.x;
    if(index>=192u*1024u)return;
    uint probe=index/1024u,texel=index%1024u;
    ivec2 px=ivec2(int(probe%16u)*32+int(texel%32u),int(probe/16u)*32+int(texel/32u));
    vec3 coord=vec3(probe%8u,(probe/8u)%3u,probe/24u);
    vec3 origin=coord-KILN_WRC_DIMS*0.5+0.5+KILN_WRC_CENTER;
    vec3 dir=kiln_octa_decode((vec2(texel%32u,texel/32u)+kiln_r2_sequence(uint(p.size_frame.z)%8u))/32.0);
    vec3 radiance; float distance; int id; vec3 n;
    if(world_trace(origin,dir,1e30,false,id,distance,n)) {
        vec3 position=origin+dir*distance;
        n=kiln_ray_normal(id);
        vec4 material=kiln_ray_material(id,position);
        Triangle tri=world_triangle(id);
        mat3 basis=kiln_orthonormal_basis(n);
        vec3 wo=transpose(basis)*-dir;
        if(wo.z<0.0){wo.z*=-0.25;wo=normalize(wo);}
        KilnLayeredBrdf brdf=kiln_layered_from_gbuffer_ndotv(material.rgb,material.w,tri.emission.a,wo.z,wrc_fg);
        brdf.specular_brdf.roughness=mix(brdf.specular_brdf.roughness,1.0,0.5);
        vec3 wi=transpose(basis)*p.sun_direction.xyz;
        radiance=tri.emission.rgb+kiln_lookup_surfel_gi(position,n)*material.rgb;
        if(!occluded(position,p.sun_direction.xyz))radiance+=kiln_layered_evaluate_directional_light(brdf,wo,wi)*max(0.0,wi.z)*kiln_sun_color(p.sun_direction.xyz,p.sun_color.rgb)*(p.sun_direction.w/PI);
    } else {radiance=kiln_sample_sky(wrc_sky,dir);distance=1e5;}
    vec4 old=imageLoad(wrc_output,px);
    vec4 value=mix(old,vec4(max(vec3(0),radiance),distance),1.0/8.0);
    value.rgb=min(value.rgb,old.rgb*2.0+safe_normalize(value.rgb));
    imageStore(wrc_output,px,value);
}
