#version 450
// Diagnostics only. Engine-owned textures do not permit direct CPU readback.
layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
layout(set=0,binding=1) uniform sampler2D depth_texture;
layout(set=0,binding=2) uniform sampler2D normal_texture;
layout(set=0,binding=3,rgba32f) uniform writeonly image2D output_geometry;
void main(){
    ivec2 q=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(q,imageSize(output_geometry))))return;
    imageStore(output_geometry,q,vec4(texelFetch(normal_texture,q,0).xyz*2.0-1.0,texelFetch(depth_texture,q,0).r));
}
