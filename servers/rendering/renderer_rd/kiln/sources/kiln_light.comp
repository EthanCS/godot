#version 450
// Deferred primary sun/emission/diffuse from Kajiya light_gbuffer.hlsl (MIT).
// RTR is demodulated by the primary preintegrated reflection before filtering.
// @GI_COMMON@
// @BVH@
// @KILN_COMMON@
// @KILN_BRDF@
// @KILN_SKY@
// @KILN_RESTIR_COMMON@
layout(set = 0, binding = 6) uniform sampler2D albedo_tex;
layout(set = 0, binding = 7) uniform sampler2D emission_tex;
layout(set = 0, binding = 8) uniform sampler2D diffuse_tex;
layout(set = 0, binding = 9, rgba16f) uniform writeonly image2D lighting_out;
layout(set = 0, binding = 11) uniform sampler2D shadow_tex;
layout(set = 0, binding = 10) uniform sampler2D reflection_tex;
layout(set = 0, binding = 19) uniform samplerCube sky_tex;
layout(set = 0, binding = 20) uniform sampler2D fg_lut;
layout(local_size_x = 8, local_size_y = 8) in;
void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (!restir_inside(px, ivec2(p.size_frame.xy))) return;
    float depth = texelFetch(restir_depth, px, 0).r;
    vec2 uv = restir_uv(px);
    vec3 sun = kiln_sun_color(p.sun_direction.xyz, p.sun_color.rgb) * (p.sun_direction.w / PI);
    if (depth == 0.0) {
        vec4 v = p.inv_projection * vec4(uv * 2.0 - 1.0, 0.0, 1.0);
        vec3 direction = safe_normalize(mat3(p.inv_view) * v.xyz);
        vec3 radiance = kiln_sample_sky(sky_tex, direction);
        const float real_radius = 0.53 * 0.5 * PI / 180.0;
        float radius_cos = min(cos(real_radius), p.lighting.x);
        float ratio = real_radius / acos(radius_cos);
        if (dot(direction, p.sun_direction.xyz) > radius_cos) radiance += 800.0 * sun * ratio * ratio;
        imageStore(lighting_out, px, vec4(radiance, 1.0)); return;
    }
    vec3 normal = restir_normal_ws(px), position = world_position(uv, depth);
    mat3 basis = restir_basis(normal);
    vec3 wo = transpose(basis) * safe_normalize(p.inv_view[3].xyz - position);
    if (wo.z < 0.0) { wo.z *= -0.25; wo = normalize(wo); }
    vec4 material = texelFetch(albedo_tex, px, 0);
    material.rgb = pow(floor(sqrt(clamp(material.rgb, vec3(0), vec3(1))) * 255.0) / 255.0, vec3(2));
    float roughness = max(1e-4, pow(texelFetch(restir_normal, px, 0).w, 2.0));
    KilnLayeredBrdf brdf = kiln_layered_from_gbuffer_ndotv(material.rgb, roughness, material.w, max(1e-5, wo.z), fg_lut);
    vec3 wi = transpose(basis) * p.sun_direction.xyz;
    float visibility = texelFetch(shadow_tex, px, 0).x;
    vec3 radiance = kiln_layered_evaluate_directional_light(brdf, wo, wi) * max(0.0, wi.z) * sun * visibility;
    radiance += texelFetch(emission_tex, px, 0).rgb;
    radiance += texelFetch(diffuse_tex, px, 0).rgb * brdf.diffuse_brdf.albedo * brdf.energy_preservation.preintegrated_transmission_fraction;
    radiance += texelFetch(reflection_tex, px, 0).rgb * brdf.energy_preservation.preintegrated_reflection;
    imageStore(lighting_out, px, vec4(radiance, 1.0));
}
