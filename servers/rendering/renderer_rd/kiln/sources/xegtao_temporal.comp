#version 450
// @GI_COMMON@
// Godot integration: reproject visibility using previous full-resolution geometry.
// AO history is independent from the GI radiance estimator and never darkens its input.
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=1) uniform sampler2D spatial;
layout(set=0,binding=2) uniform sampler2D depth;
layout(set=0,binding=3) uniform sampler2D normal;
layout(set=0,binding=4) uniform sampler2D history;
layout(set=0,binding=5) uniform sampler2D previous_geometry_depth;
layout(set=0,binding=6) uniform sampler2D previous_geometry_normal;
layout(set=0,binding=7,r16f) uniform writeonly image2D output_history;
layout(set=0,binding=8,r16f) uniform writeonly image2D output_ao;
layout(push_constant,std430) uniform Pass { int frames; } pass;
vec3 unpack_normal(float value){
    uint packed=uint(round(value));vec2 v=vec2(packed&4095u,packed>>12)*(2.0/4095.0)-1.0;
    vec3 n=vec3(v,1.0-abs(v.x)-abs(v.y));
    n.xy+=mix(vec2(1),vec2(-1),greaterThanEqual(n.xy,vec2(0)))*max(-n.z,0.0);
    return safe_normalize(n);
}
void main(){
    ivec2 q=ivec2(gl_GlobalInvocationID.xy),size=textureSize(spatial,0);
    if(any(greaterThanEqual(q,size)))return;
    float value=texelFetch(spatial,q,0).r,d=texelFetch(depth,q,0).r;
    if(pass.frames>0 && p.size_frame.w>.5 && d>1e-7){
        vec2 uv=(vec2(q)+.5)/vec2(size);
        vec3 vp=view_position(uv,d),wp=(p.inv_view*vec4(vp,1)).xyz;
        vec3 n=normalize(mat3(p.inv_view)*(p.engine_state.x>.5?texelFetch(normal,q,0).rgb:texelFetch(normal,q,0).rgb*2.0-1.0));
        vec4 clip=p.previous_view_projection*vec4(wp,1);
        vec2 old_pixel=(clip.xy/clip.w*.5+.5)*vec2(size)-.5;
        ivec2 base=ivec2(floor(old_pixel));
        float sum=0,weight=0;
        float pixel_world=2.0*abs(vp.z)/(abs(p.projection[1][1])*float(size.y));
        if(clip.w>0.0)for(int y=0;y<2;y++)for(int x=0;x<2;x++){
            ivec2 tap=base+ivec2(x,y);
            if(any(lessThan(tap,ivec2(0)))||any(greaterThanEqual(tap,size)))continue;
            float old_depth=texelFetch(previous_geometry_depth,tap,0).a;
            if(old_depth<1e-7)continue;
            vec4 old_world=p.previous_inverse_view_projection*vec4((vec2(tap)+.5)/vec2(size)*2.0-1.0,old_depth,1);
            old_world/=old_world.w;
            vec3 old_normal=unpack_normal(texelFetch(previous_geometry_normal,tap,0).a);
            if(dot(n,old_normal)<.98||length(old_world.xyz-wp)>max(.02,2.0*pixel_world)
                ||abs(dot(n,old_world.xyz-wp))>max(.003,pixel_world*.25))continue;
            vec2 offset=abs(vec2(tap)-old_pixel);
            float w=(1.0-offset.x)*(1.0-offset.y);
            sum+=texelFetch(history,tap,0).r*w;weight+=w;
        }
        if(weight>.01){
            float lo=1,hi=0;
            for(int y=-1;y<=1;y++)for(int x=-1;x<=1;x++){
                float sample_ao=texelFetch(spatial,clamp(q+ivec2(x,y),ivec2(0),size-1),0).r;
                lo=min(lo,sample_ao);hi=max(hi,sample_ao);
            }
            float previous=clamp(sum/weight,lo-.03,hi+.03);
            value=mix(previous,value,max(1.0/float(min(pass.frames+1,32)),p.quality.y>.5?.15:0.0));
        }
    }
    imageStore(output_history,q,vec4(value));imageStore(output_ao,q,vec4(value));
}
