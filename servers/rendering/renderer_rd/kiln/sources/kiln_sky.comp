#version 450
// lighting sky cube: rust-gpu sky.rs comp_sky_cube_cs, ported. 32px RGBA16F, six faces.
// @GI_COMMON@
// @KILN_COMMON@
// @KILN_SKY@
layout(set = 0, binding = 1, rgba16f) uniform writeonly imageCube sky_cube;
layout(local_size_x = 8, local_size_y = 8) in;
void main() {
	ivec3 px = ivec3(gl_GlobalInvocationID);
	if (px.x >= KILN_SKY_DIMS || px.y >= KILN_SKY_DIMS || px.z >= 6) {
		return;
	}
	int face = px.z;
	vec2 uv = (vec2(px.x, px.y) + 0.5) / float(KILN_SKY_DIMS);
	vec3 dir = kiln_cube_face_rotation(face, vec3(uv * 2.0 - 1.0, -1.0));
	vec3 radiance = kiln_atmosphere_default(normalize(dir), p.sun_direction.xyz, vec3(0.0), vec3(1.0));
	imageStore(sky_cube, px, vec4(radiance, 1.0));
}
