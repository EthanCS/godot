#!/usr/bin/env python
from misc.utility.scons_hints import *
from pathlib import Path
import subprocess
import sys

Import("env")

def blue_noise_builder(target, source, env):
    data = Path(str(source[0])).read_bytes()
    rows = [", ".join(str(b) for b in data[i:i+24]) for i in range(0, len(data), 24)]
    Path(str(target[0])).write_text("// Generated from data/blue_noise.png (Christoph Peters, CC0).\n"
                                  "static const unsigned char kiln_blue_noise_png[] = {\n" + ",\n".join(rows) + "\n};\n")

env.CommandNoCache("blue_noise.gen.h", "data/blue_noise.png", env.Run(blue_noise_builder))

def reflection_noise_builder(target, source, env):
    data = Path(str(source[0])).read_bytes()
    rows = [", ".join(str(b) for b in data[i:i+24]) for i in range(0, len(data), 24)]
    Path(str(target[0])).write_text("// blue-noise-sampler 0.1.0 (MIT), see licenses/BLUE-NOISE-SPP64-NOTICE.txt.\n"
                                  "static const unsigned char kiln_rtr_noise_bytes[] = {\n" + ",\n".join(rows) + "\n};\n")

env.CommandNoCache("rtr_noise.gen.h", "data/blue_noise_spp64.bin", env.Run(reflection_noise_builder))

def surfel_shader_builder(target, source, env):
    subprocess.check_call([sys.executable, str(source[0])])

root = Path(env.Dir("#").abspath)
inputs = [env.File("#kiln/tools/build_gi_shaders.py")]
inputs += [env.File(str(p)) for p in sorted((root / "servers/rendering/renderer_rd/kiln/sources").glob("*")) if p.suffix in (".comp", ".inc")]
env.CommandNoCache("#servers/rendering/renderer_rd/shaders/kiln_gi.glsl", inputs, env.Run(surfel_shader_builder))
kiln_env = env.Clone()
# SDK stays outside tracked source: NVIDIA's license is not the engine MIT license.
nrd_root = Path(ARGUMENTS.get("kiln_nrd_sdk", str(root / "bin/build_deps/NRD")))
if ARGUMENTS.get("kiln_nrd", "yes") != "no" and env["platform"] == "windows" and (nrd_root / "_Bin/Release/NRD.lib").is_file():
    nrd_commit = subprocess.check_output(["git", "-C", str(nrd_root), "rev-parse", "HEAD"], text=True).strip()
    if nrd_commit != "792eff196afdd350fd9c3f862119017ccb438a0e":
        raise RuntimeError("Kiln requires NRD v4.17.3; run kiln/tools/prepare_nrd.py with the pinned SDK")
    kiln_env.Append(CPPPATH=[str(nrd_root / "Include")], CPPDEFINES=["KILN_NRD_ENABLED"])
    env.Append(LIBS=[env.File(str(nrd_root / "_Bin/Release/NRD.lib")), env.File(str(nrd_root / "_Build417/_deps/shadermake-build/Release/ShaderMakeBlob.lib"))])
kiln_env.add_source_files(env.servers_sources, "*.cpp")
